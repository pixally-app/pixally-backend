{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true }]
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/*.dto.ts",
    "!src/**/*.spec.ts",
    "!src/app.controller.ts",
    "!src/app.service.ts",
    "!src/prisma/**",
    "!src/pix-receipts/ocr.service.ts",
    "!src/pix-receipts/openai.service.ts",
    "!src/pix-receipts/storage.service.ts",
    "!src/pix-receipts/queue.service.ts"
  ],
  "coverageDirectory": "coverage/e2e"
}
